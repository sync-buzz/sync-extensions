{
  // What an extension is allowed to name.
  //
  // `@sync/extension-api` resolves through node_modules like any dependency,
  // and there is nothing else to resolve: an extension has no access to Sync's
  // source, so an import that reaches past the contract does not type-check
  // rather than being caught by review.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["extensions/*/src/**/*.ts", "extensions/*/src/**/*.tsx"]
}
